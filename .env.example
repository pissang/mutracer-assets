# OAuth token from Sketchfab Login. Never commit actual credentials.
SKETCHFAB_ACCESS_TOKEN=
# Alternatively, a personal Sketchfab API token (Token authentication).
SKETCHFAB_API_TOKEN=
# Checkout with dependencies installed; default: ../mutracer
MUTRACER_ROOT=
# Only needed for retained R2 models. Or pass --bucket / --public-base.
R2_BUCKET=mutracer-assets
R2_PUBLIC_BASE_URL=
# Wrangler login can be used instead of Cloudflare environment credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
